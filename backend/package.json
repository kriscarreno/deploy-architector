{
  "name": "deploy-orchestrator-backend",
  "version": "1.0.0",
  "description": "Deploy Orchestrator backend — Express + SQLite + Redis + Bull",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/workers/deployWorker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/deployWorker.ts",
    "migrate": "tsx src/config/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "simple-git": "^3.24.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.13.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.16",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
